# Database — PostgreSQL (use the Docker service name "db" as host)
DATABASE_URL="postgresql://postgres:CHANGEME@db:5432/future_os?schema=public"

# Auth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGEME"
NEXTAUTH_URL="http://YOUR_SERVER_IP"

# Mock mode
NEXT_PUBLIC_USE_MOCK="false"

# Sentry (optional)
# NEXT_PUBLIC_SENTRY_DSN=""
