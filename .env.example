# Database — PostgreSQL
# Local: postgresql://postgres:postgres@localhost:5432/future_os?schema=public
# Production: use your hosted PostgreSQL URL (Neon, Supabase, Railway, etc.)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/future_os?schema=public"

# Auth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Set to "true" to use mock localStorage instead of real database
NEXT_PUBLIC_USE_MOCK="false"

# Sentry (optional — error tracking in production)
# Create a project at https://sentry.io and paste your DSN here
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""

# PowerSync (optional — enables offline-first with sync)
# Get your URL from https://powersync.cloud
# NEXT_PUBLIC_POWERSYNC_URL=""
